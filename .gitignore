# ==========================================
# Environment & Secrets (NEVER COMMIT)
# ==========================================
.env
.env.*
*.env
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Allow example files
!.env.example
!backend/.env.example
!frontend/.env.example

# Local user credential store & session data
local_users.json
backend/app/data/local_users.json
backend/local_users.json

# ==========================================
# Python & Virtual Environments
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/__pycache__/
backend/app/**/__pycache__/
venv/
venv*/
backend/venv/
.venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
*.coverage.*

# ==========================================
# Node.js & Frontend
# ==========================================
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# ==========================================
# User Uploads & Temporary Files
# ==========================================
backend/uploads/*
!backend/uploads/.gitkeep
*.pdf

# ==========================================
# Operating System & IDEs
# ==========================================
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.log
