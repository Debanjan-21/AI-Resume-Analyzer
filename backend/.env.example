# MongoDB Database Configuration
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?appName=Cluster0
DATABASE_NAME=ai_resume_analyzer

# JWT Authentication
JWT_SECRET_KEY=your-secure-random-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google Gemini API Key
GEMINI_API_KEY=your-google-gemini-api-key-here

# Email Dispatch: Option A (Resend API - Recommended)
RESEND_API_KEY=re_your_resend_api_key_here

# Email Dispatch: Option B (Standard SMTP Relay, e.g. Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
FRONTEND_URL=http://localhost:3000
